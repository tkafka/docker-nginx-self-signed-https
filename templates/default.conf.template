# Rendered from this template at container start by the official nginx image's
# envsubst entrypoint (/docker-entrypoint.d/20-envsubst-on-templates.sh).
# ${VAR} placeholders are replaced with the matching environment variables;
# nginx runtime variables ($host, $scheme, ...) are left untouched.

# Send "Connection: upgrade" to the upstream only for WebSocket requests,
# and "Connection: close" for everything else so regular keepalive works.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${HTTP_PORT};
  return 302 https://$host:${HTTPS_PORT}$request_uri;
}

server {
  listen ${HTTPS_PORT} ssl;
  http2 on;
  server_name localhost;
  server_tokens off;

  ssl_certificate /etc/nginx/cert.crt;
  ssl_certificate_key /etc/nginx/cert.key;

  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # Modern-safe protocols and ciphers (Mozilla "intermediate", ECDHE-only so no
  # dhparam file is required). TLS 1.3 cipher suites are negotiated automatically.
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;

  # We intentionally do not set HSTS / security headers here; that is the job of
  # the proxied application. This image only adds the HTTPS termination.
  # add_header Strict-Transport-Security "max-age=3600";
  # add_header X-Content-Type-Options nosniff;
  # add_header X-XSS-Protection "1; mode=block";

  location / {
    resolver 127.0.0.11 ipv6=off;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket support
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_pass ${REMOTE_URL};

    proxy_read_timeout ${TIMEOUTS_S};
    send_timeout ${TIMEOUTS_S};
    client_body_timeout ${TIMEOUTS_S};
    keepalive_timeout ${TIMEOUTS_S};
    lingering_timeout ${TIMEOUTS_S};

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    client_body_buffer_size ${CLIENT_BODY_BUFFER_SIZE};

    # Stream large uploads/downloads straight through instead of buffering them
    # to a temporary file ("an upstream response is buffered to a temporary file").
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_max_temp_file_size 0;
  }
}
